{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ · %@" : {
      "comment" : "Displays the material of a garment color tile and the last used date in a small font.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ · %@ · %@" : {
      "comment" : "A set of text labels describing the material, color, and fit of a garment.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@ · %3$@"
          }
        }
      }
    },
    "%@ %@" : {
      "comment" : "A label displaying the name of a garment color, followed by its category and material.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@°" : {
      "comment" : "A temperature displayed in the suggestion view. The value is the temperature in degrees Celsius.",
      "isCommentAutoGenerated" : true
    },
    "%@d" : {
      "comment" : "A badge displaying the number of days since a garment was last used. The text inside the badge changes color based on whether the garment has been used in the last 30, 60, or more days",
      "isCommentAutoGenerated" : true
    },
    "°C" : {
      "comment" : "A unit of temperature, displayed in the settings.",
      "isCommentAutoGenerated" : true
    },
    "°F" : {
      "comment" : "A unit of temperature displayed in the settings.",
      "isCommentAutoGenerated" : true
    },
    "1.0.0" : {
      "comment" : "The version number of the app.",
      "isCommentAutoGenerated" : true
    },
