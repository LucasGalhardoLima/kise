    "onboarding.locationDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KISE uses your location to check the weather and suggest outfits that match your day. Your location is never stored or shared."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O KISE usa sua localização para verificar o clima e sugerir looks adequados ao seu dia. Sua localização nunca é armazenada ou compartilhada."
          }
        }
      }
    },
    "onboarding.locationTitle" : {
      "localizations" : {
