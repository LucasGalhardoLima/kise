    "onboarding.demoDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every outfit is a color palette. Larger blocks are your dominant pieces — they set the tone. Smaller ones are accents that complete the harmony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo look é uma paleta de cores. Os blocos maiores são as peças dominantes — elas definem o tom. Os menores são acentos que completam a harmonia."
          }
        }
      }
    },
    "onboarding.demoTitle" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
