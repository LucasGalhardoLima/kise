---
import "@fontsource/cormorant-garamond/300.css";
import "@fontsource/dm-sans/400.css";
import "@fontsource/dm-sans/500.css";

interface Props {
  title: string;
  description: string;
  lang: string;
}

const { title, description, lang } = Astro.props;
---

<!doctype html>
<html lang={lang} class="bg-dust text-pine">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="font-body antialiased">
    <main class="mx-auto max-w-content px-6 py-16">
      <slot />
    </main>
    <script src="../scripts/waitlist.ts"></script>
    <script src="../scripts/reveal.ts"></script>
  </body>
</html>

<style is:global>
  /* Scroll reveal base styles */
  [data-reveal] {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  [data-reveal].revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* Variant: larger float-up for mockup */
  [data-reveal="float"] {
    transform: translateY(30px);
  }

  /* Variant: subtle for footer */
  [data-reveal="subtle"] {
    transform: translateY(10px);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .animate-fade-in-up {
      animation: none !important;
      opacity: 1 !important;
    }
  }
</style>
