---
// kise-landing/src/components/System.astro
interface Props {
  title: string;
  body: string;
  pullQuote: string;
}

const { title, body, pullQuote } = Astro.props;
---

<section class="py-[120px]">
  <h2 class="font-brand text-3xl font-light">{title}</h2>
  <p class="mt-6 font-body text-base leading-relaxed text-pine/70">{body}</p>
  <blockquote class="mt-12 border-l-2 border-sage pl-6 font-brand text-[28px] font-light italic leading-snug text-pine/80 sm:text-[32px]">
    {pullQuote}
  </blockquote>
</section>
