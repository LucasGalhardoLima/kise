---
// kise-landing/src/components/AppMockup.astro
// Pure CSS mockup of the KISE app Home screen — no title, just the phone frame

interface Props {
  lang: "pt-BR" | "en-US";
}

const { lang } = Astro.props;

const copy = lang === "pt-BR" ? {
  title: "Hoje",
  occasions: ["Dia a dia", "Reunião", "Encontro", "Noite"],
  sectionLabel: "SEU LOOK",
  pieces: "Polo Vinho Bordô · Chinos Sálvia · Calçados Preto",
  reasoning: "A combinação de polo burgundy com chinos sage cria um look smart casual equilibrado com cores terrosas e elegantes. Os sapatos de couro preto adicionam um toque mais refinado que eleva o conjunto casual.",
  alternative: "Sapatos sintéticos pretos mantêm o visual mais descontraído e confortável para o dia a dia.",
  safe: "SEGURO",
  bold: "OUSADO",
  tryAnother: "Tentar outro",
  tabs: ["Início", "Guarda-roupa", "Configurações"],
} : {
  title: "Today",
  occasions: ["Everyday", "Meeting", "Date", "Night Out"],
  sectionLabel: "YOUR LOOK",
  pieces: "Burgundy Polo · Sage Chinos · Black Shoes",
  reasoning: "The burgundy polo with sage chinos creates a balanced smart casual look with earthy, elegant tones. The black leather shoes add a refined touch that elevates the casual outfit.",
  alternative: "Black synthetic shoes keep the look more relaxed and comfortable for everyday wear.",
  safe: "SAFE",
  bold: "BOLD",
  tryAnother: "Try another",
  tabs: ["Home", "Wardrobe", "Settings"],
};

const colors = { burgundy: "#722F37", sage: "#A3B18A", black: "#1A1A1A" };
---

<div data-reveal="float" class="mx-auto max-w-[320px] transition-transform duration-500 hover:scale-[1.02]">
  <!-- Phone frame -->
  <div class="overflow-hidden rounded-[40px] border-[8px] border-[#1A1A1A] bg-[#F5F3EF] shadow-2xl">
    <!-- Status bar -->
    <div class="flex items-center justify-between px-6 pt-3 pb-1">
      <span class="font-body text-[11px] font-medium text-[#344E41]">15:55</span>
      <div class="h-[28px] w-[90px] rounded-full bg-black"></div>
      <div class="flex items-center gap-1">
        <svg width="14" height="10" viewBox="0 0 14 10" fill="#344E41"><path d="M7 0C4.24 0 1.73 1.11 0 2.85l2.12 2.12C3.47 3.63 5.14 2.88 7 2.88s3.53.75 4.88 2.09L14 2.85C12.27 1.11 9.76 0 7 0z" opacity=".3"/><path d="M7 2.88c-1.86 0-3.53.75-4.88 2.09l2.12 2.12C5.09 6.24 5.99 5.75 7 5.75s1.91.49 2.76 1.34l2.12-2.12C10.53 3.63 8.86 2.88 7 2.88z" opacity=".6"/><path d="M7 5.75c-1.01 0-1.91.49-2.76 1.34L7 10l2.76-2.91C8.91 6.24 8.01 5.75 7 5.75z"/></svg>
        <svg width="18" height="10" viewBox="0 0 18 10" fill="#344E41"><rect x="0" y="1" width="15" height="8" rx="1.5" stroke="#344E41" stroke-width=".8" fill="none"/><rect x="1.5" y="2.5" width="12" height="5" rx=".5" fill="#344E41"/><path d="M16 4v2.5a1.2 1.2 0 0 0 0-2.5z" fill="#344E41" opacity=".4"/></svg>
      </div>
    </div>

    <!-- App content -->
    <div class="px-5 pb-2">
      <!-- Title -->
      <p class="mt-2 text-center font-brand text-[22px] font-light text-[#344E41]">{copy.title}</p>

      <!-- Occasion pills -->
      <div class="mt-3 flex justify-center gap-1.5">
        {copy.occasions.map((occ, i) => (
          <span
            class:list={[
              "rounded-full px-2.5 py-1 font-body text-[9px]",
              i === 0
                ? "bg-[#3A5A40] text-[#F5F3EF]"
                : "border border-[#A3B18A] text-[#344E41]"
            ]}
          >
            {occ}
          </span>
        ))}
      </div>

      <!-- Section label -->
      <p class="mt-4 font-body text-[8px] font-medium uppercase tracking-[3px] text-[#9B9B9B]">{copy.sectionLabel}</p>

      <!-- Composition -->
      <div class="relative mt-2 aspect-[4/3] w-full">
        <div class="absolute shadow-sm" style={`background:${colors.burgundy};left:3%;top:12%;width:42%;height:65%`}></div>
        <div class="absolute shadow-sm" style={`background:${colors.sage};left:28%;top:3%;width:52%;height:42%`}></div>
        <div class="absolute shadow-sm" style={`background:${colors.black};left:35%;top:50%;width:45%;height:38%`}></div>
      </div>

      <!-- Piece names -->
      <p class="mt-3 text-center font-body text-[9px] text-[#6B6B6B]">{copy.pieces}</p>

      <!-- Reasoning -->
      <p class="mt-3 font-body text-[9px] leading-[1.5] text-[#344E41]/80">{copy.reasoning}</p>

      <!-- Alternative -->
      <div class="mt-2 flex items-start gap-1.5">
        <svg class="mt-0.5 shrink-0 text-[#9B9B9B]" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M21 21v-5h-5"/></svg>
        <p class="font-body text-[8px] leading-[1.5] text-[#9B9B9B]">{copy.alternative}</p>
      </div>

      <!-- Boldness slider -->
      <div class="mt-3 flex items-center gap-2">
        <span class="font-body text-[7px] uppercase tracking-[1px] text-[#9B9B9B]">{copy.safe}</span>
        <div class="flex-1 rounded-full border border-[#E5E1DB] bg-white px-1.5 py-1.5">
          <div class="relative h-[3px] rounded-full bg-[#E5E1DB]">
            <div class="absolute left-0 top-0 h-full w-[30%] rounded-full bg-[#3A5A40]"></div>
            <div class="absolute top-1/2 -translate-y-1/2 rounded-full bg-white shadow" style="left:28%;width:10px;height:10px;border:1px solid #E5E1DB"></div>
          </div>
        </div>
        <span class="font-body text-[7px] uppercase tracking-[1px] text-[#9B9B9B]">{copy.bold}</span>
      </div>

      <!-- Action row -->
      <div class="mt-3 flex items-center justify-center gap-4">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#9B9B9B" stroke-width="1.5"><path d="M17 14V2M9 18a4 4 0 0 0 4-4V2M5 12l2.5-2.5L10 12"/></svg>
        <div class="flex items-center gap-1 rounded-full border border-[#E5E1DB] px-3 py-1">
          <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="#9B9B9B" stroke-width="2"><path d="M21 12a9 9 0 1 1-9-9"/><path d="M21 3v6h-6"/></svg>
          <span class="font-body text-[8px] text-[#9B9B9B]">{copy.tryAnother}</span>
        </div>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#9B9B9B" stroke-width="1.5"><path d="M7 10V22M15 6a4 4 0 0 0-4 4v12M19 12l-2.5 2.5L14 12"/></svg>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#9B9B9B" stroke-width="1.5"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
      </div>
    </div>

    <!-- Tab bar -->
    <div class="mt-2 flex items-end justify-around border-t border-[#E5E1DB]/50 bg-white/80 px-2 pb-5 pt-2">
      <div class="flex flex-col items-center gap-0.5">
        <div class="rounded-full bg-[#3A5A40]/10 p-1.5">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="#3A5A40"><path d="M6 2a2 2 0 0 0-2 2v3a1 1 0 0 0 .293.707L6 9.414V20a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V9.414l1.707-1.707A1 1 0 0 0 20 7V4a2 2 0 0 0-2-2H6z"/></svg>
        </div>
        <span class="font-body text-[8px] font-medium text-[#3A5A40]">{copy.tabs[0]}</span>
      </div>
      <div class="flex flex-col items-center gap-0.5">
        <div class="p-1.5">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#9B9B9B" stroke-width="1.5"><rect x="2" y="4" width="20" height="16" rx="2"/><line x1="12" y1="4" x2="12" y2="20"/></svg>
        </div>
        <span class="font-body text-[8px] text-[#9B9B9B]">{copy.tabs[1]}</span>
      </div>
      <div class="flex flex-col items-center gap-0.5">
        <div class="p-1.5">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#9B9B9B" stroke-width="1.5"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        </div>
        <span class="font-body text-[8px] text-[#9B9B9B]">{copy.tabs[2]}</span>
      </div>
    </div>
  </div>
</div>
