---
// kise-landing/src/components/Footer.astro
interface Props {
  tagline: string;
  appStore: string;
  copyright: string;
  threadsUrl: string;
}

const { tagline, appStore, copyright, threadsUrl } = Astro.props;
---

<footer class="border-t border-sage/20 py-12 text-center">
  <p data-reveal="subtle" class="font-brand text-xl font-light">KISE 着せ</p>
  <p data-reveal="subtle" data-reveal-delay="100" class="mt-2 font-body text-sm text-pine/50">{tagline}</p>
  <p data-reveal="subtle" data-reveal-delay="150" class="mt-3 font-body text-xs text-pine/40">{appStore}</p>
  <div data-reveal="subtle" data-reveal-delay="200" class="mt-4 flex items-center justify-center gap-4">
    <a
      href={threadsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 font-body text-sm text-fern transition-colors duration-200 hover:text-hunter"
      aria-label="Threads"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.589 12c.027 3.086.718 5.496 2.057 7.164 1.43 1.783 3.631 2.698 6.54 2.717 2.623-.02 4.358-.631 5.8-2.045 1.647-1.613 1.618-3.593 1.09-4.798-.31-.71-.873-1.3-1.634-1.753-.163 1.078-.555 2.025-1.193 2.772-.795.93-1.907 1.517-3.282 1.742-1.217.2-2.398.07-3.322-.366-1.04-.49-1.712-1.302-1.882-2.285-.37-2.157 1.32-3.793 4.502-4.353 1.405-.247 2.676-.202 3.784.1-.06-.36-.165-.693-.317-.993-.428-.843-1.247-1.292-2.378-1.31-1.184.008-2.058.37-2.51.679l-1.036-1.683c1.093-.723 2.516-1.12 4.003-1.116h.034c1.792.03 3.202.67 4.077 1.846.69.928 1.065 2.126 1.116 3.563.649.357 1.222.802 1.7 1.34 1.305 1.47 1.738 3.363 1.215 5.32-.616 2.31-2.48 4.2-5.252 5.316-1.278.514-2.728.79-4.323.82z"/>
      </svg>
      Threads
    </a>
  </div>
  <p class="mt-6 font-body text-xs text-pine/30">{copyright}</p>
</footer>
