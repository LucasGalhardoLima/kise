---
// kise-landing/src/components/WhyKise.astro
interface Props {
  title: string;
  opening: string;
  pain: string;
  solution: string;
  closing: string;
}

const { title, opening, pain, solution, closing } = Astro.props;
---

<section class="py-[140px]">
  <h2 data-reveal class="font-brand text-5xl font-light tracking-[0.02em] sm:text-[56px]">{title}</h2>

  <div class="mt-10 space-y-6 font-body text-base leading-relaxed text-pine/70">
    <p data-reveal data-reveal-delay="100" class="font-brand text-2xl font-light italic text-pine/80">{opening}</p>
    <p data-reveal data-reveal-delay="200">{pain}</p>
    <p data-reveal data-reveal-delay="300">{solution}</p>
    <p data-reveal data-reveal-delay="400" class="font-body text-lg font-medium text-pine">{closing}</p>
  </div>
</section>
