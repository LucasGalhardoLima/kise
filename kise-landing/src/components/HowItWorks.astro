---
// kise-landing/src/components/HowItWorks.astro
interface Props {
  title: string;
  steps: { icon: string; title: string; body: string }[];
}

const { title, steps } = Astro.props;
---

<section class="py-20">
  <h2 class="font-brand text-3xl font-light">{title}</h2>
  <div class="mt-10 grid gap-10 sm:grid-cols-3">
    {steps.map((step) => (
      <div>
        <span class="text-2xl">{step.icon}</span>
        <h3 class="mt-3 font-brand text-xl font-light">{step.title}</h3>
        <p class="mt-2 font-body text-sm text-pine/60">{step.body}</p>
      </div>
    ))}
  </div>
</section>
