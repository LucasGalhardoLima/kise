---
// kise-landing/src/components/WaitlistForm.astro
interface Props {
  title: string;
  body: string;
  cta: string;
  success: string;
  placeholder?: string;
}

const { title, body, cta, success, placeholder = "" } = Astro.props;
---

<section class="pb-[80px] pt-[140px] text-center">
  <h2 data-reveal class="font-brand text-5xl font-light tracking-[0.02em] sm:text-[56px]">{title}</h2>
  <p data-reveal data-reveal-delay="100" class="mt-4 font-body text-base text-pine/60">{body}</p>

  <form data-reveal data-reveal-delay="200" class="mt-8 flex justify-center gap-3" data-waitlist>
    <input
      type="email"
      name="email"
      required
      placeholder={placeholder}
      class="w-64 rounded-lg border border-sage/40 bg-white px-4 py-3 font-body text-sm text-pine transition-colors duration-200 placeholder:text-pine/30 focus:border-fern focus:outline-none"
    />
    <button
      type="submit"
      class="rounded-lg bg-fern px-6 py-3 font-body text-sm font-medium text-dust transition-all duration-200 hover:-translate-y-px hover:bg-hunter hover:shadow-md"
    >
      {cta}
    </button>
  </form>
  <p class="mt-2 hidden font-body text-sm text-fern" data-waitlist-success>{success}</p>
</section>
