---
// kise-landing/src/components/Credibility.astro
interface Props {
  statements: readonly string[];
}

const { statements } = Astro.props;
---

<section class="border-y border-sage/20 py-16">
  <div class="flex flex-col items-center gap-7">
    {statements.map((statement) => (
      <p class="text-center font-body text-sm font-light uppercase tracking-[0.15em] text-sage">
        {statement}
      </p>
    ))}
  </div>
</section>
