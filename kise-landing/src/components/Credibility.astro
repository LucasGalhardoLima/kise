---
// kise-landing/src/components/Credibility.astro
interface Props {
  statements: readonly string[];
}

const { statements } = Astro.props;
---

<section class="border-y border-sage/20 py-12">
  <div class="flex flex-col items-center gap-6 sm:flex-row sm:justify-between">
    {statements.map((statement) => (
      <p class="text-center font-body text-xs uppercase tracking-[0.2em] text-sage">
        {statement}
      </p>
    ))}
  </div>
</section>
