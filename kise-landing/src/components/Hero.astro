---
// kise-landing/src/components/Hero.astro
interface Props {
  tagline: string;
}

const { tagline } = Astro.props;
---

<section class="flex min-h-[70vh] flex-col items-center justify-center text-center">
  <h1 class="font-brand text-7xl font-light tracking-tight sm:text-8xl">KISE 着せ</h1>
  <p class="mt-6 font-body text-lg text-pine/70">{tagline}</p>

  <div class="mt-16 animate-bounce">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke="currentColor" class="text-sage/60">
      <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>
</section>
